# EditorConfig - Consistent coding styles across editors
# See: https://editorconfig.org

root = true

# Default for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Rust files
[*.rs]
indent_size = 4

# TOML files (Cargo.toml, etc.)
[*.toml]
indent_size = 4

# YAML files (CI configs)
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# JSON
[*.json]
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab

# Git config files
[.git*]
indent_size = 4
